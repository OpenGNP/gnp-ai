# Same database the server uses. Copy from gnp-server/.env — never commit the real file.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5433/opengnp_db

# Local Ollama running mistral:7b-instruct (brew services start ollama)
OLLAMA_URL=http://localhost:11434
DECOMPOSE_MODEL=mistral:7b-instruct
# v0-v4 are rule-based prompts; fewshot/count/annotated replace the whole prompt.
# fewshot chosen: 1.30 points/response on a 30-row sample, keeps the writer's wording,
# no empty outputs. See data/reports/decompose_sample30_four_way.txt
DECOMPOSE_PROMPT=fewshot
EMBEDDING_MODEL=all-MiniLM-L6-v2
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Violation detection: zero-shot NLI, ~370MB, ~0.56s/point on CPU.
# Threshold swept on data/violation_testset.csv (88% correct, 0 false positives).
# Swap the model for MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7 for Thai.
VIOLATION_ZEROSHOT_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
VIOLATION_ZEROSHOT_THRESHOLD=0.65

# Legacy toxic-bert backend, kept only for scripts/test_violation.py --backend toxic-bert
VIOLATION_MODEL=unitary/toxic-bert
VIOLATION_THRESHOLD=0.5
CLASSIFIER_BATCH_SIZE=16

# Clustering knobs, as a percentage of corpus size. Defaults reproduce the tuned
# run at n=145 (mcs=4, split-large=13, outlier threshold 0.30).
MIN_CLUSTER_SIZE_PCT=2.8
SPLIT_LARGE_PCT=9.0
OUTLIER_THRESHOLD=0.30

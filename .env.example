# Same database the server uses. Copy the value from gnp-server/.env — never
# commit the real file.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5433/opengnp_db

# Which Postgres schema holds the app's tables. The server moved them into
# `test` for a while and then dropped it; `public` is the live one again.
DB_SCHEMA=public

# ── decomposition ──────────────────────────────────────────────────────
# Local Ollama running mistral:7b-instruct (brew services start ollama)
OLLAMA_URL=http://localhost:11434
DECOMPOSE_MODEL=mistral:7b-instruct
# v0-v4 are rule-based prompts; fewshot/count/annotated replace the whole
# prompt instead of its rules. v2 splits more than gold (2.49 against 1.31) but
# never under-splits, which fewshot does. See
# data/reports/decompose_sample30_four_way.txt
DECOMPOSE_PROMPT=v2

# ── embedding ──────────────────────────────────────────────────────────
# 384 dimensions, zero-padded to whatever width the column declares.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── sentiment ──────────────────────────────────────────────────────────
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
CLASSIFIER_BATCH_SIZE=16

# ── violation ──────────────────────────────────────────────────────────
# Zero-shot NLI, ~370MB, ~2s per point on CPU. The hypotheses live in
# pipeline/violation.py and matter more than the model: naming concrete acts
# instead of "abuse of authority" is what stopped ordinary complaints about
# teaching from being flagged.
# Threshold swept on data/violation_testset.csv (42 labelled cases):
# 0.75 gives 83% correct with 3 false positives, 0.65 gives 81% with 4.
# Swap the model for MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# to cover Thai.
VIOLATION_ZEROSHOT_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
VIOLATION_ZEROSHOT_THRESHOLD=0.75

# Legacy toxic-bert backend. Unused by the pipeline, kept only so
# scripts/test_violation.py --backend toxic-bert can still compare against it.
VIOLATION_MODEL=unitary/toxic-bert
VIOLATION_THRESHOLD=0.5

# ── clustering ─────────────────────────────────────────────────────────
# As a percentage of corpus size, because a fixed min_cluster_size calibrated
# at n=145 goes coarse as the corpus grows. 2.8% was that original calibration
# and produced a single topic holding 81% of a 653-point corpus; 0.8% keeps
# topics the right size at that scale.
MIN_CLUSTER_SIZE_PCT=0.8
SPLIT_LARGE_PCT=3.0
# Cosine floor for pulling an HDBSCAN noise point into its nearest topic.
OUTLIER_THRESHOLD=0.30

# ── topic identity across runs ─────────────────────────────────────────
# A new cluster inherits an existing topic's id when it holds at least this
# share of that topic's surviving points, which is what keeps topic_trends
# continuous. Starting points, not calibrated.
TOPIC_CARRY_MIN=0.50
TOPIC_SPLIT_MIN=0.20

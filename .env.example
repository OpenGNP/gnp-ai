# Same database the server uses. Copy from gnp-server/.env — never commit the real file.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5433/opengnp_db

# Local Ollama running mistral:7b-instruct (brew services start ollama)
OLLAMA_URL=http://localhost:11434
DECOMPOSE_MODEL=mistral:7b-instruct
DECOMPOSE_PROMPT=v1
EMBEDDING_MODEL=all-MiniLM-L6-v2
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
VIOLATION_MODEL=unitary/toxic-bert
VIOLATION_THRESHOLD=0.5
CLASSIFIER_BATCH_SIZE=16

# Clustering knobs, as a percentage of corpus size. Defaults reproduce the tuned
# run at n=145 (mcs=4, split-large=13, outlier threshold 0.30).
MIN_CLUSTER_SIZE_PCT=2.8
SPLIT_LARGE_PCT=9.0
OUTLIER_THRESHOLD=0.30
